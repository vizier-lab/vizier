{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "rs.vizier.app",
  "productName": "Vizier",
  "build": {
    "frontendDist": "../../webui/build/client",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../../webui", "wait": false },
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: vizier-asset: http://vizier-asset.localhost; media-src 'self' blob: vizier-asset: http://vizier-asset.localhost; connect-src 'self' ipc: http://ipc.localhost vizier-asset: http://vizier-asset.localhost; style-src 'self' 'unsafe-inline'; frame-src 'self' blob: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "appimage",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "vizier"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/vizier-lab/vizier/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA4MjlEQjFDNjFGMzI3MjUKUldRbEovTmhITnNwQ0JVVTd6YWwzSXlXZVBDVis0ZXFaWnpxWm9VNWlzd3VXOGlXUEpxSUt2cGcK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}