{
  "body": {
    "include": [
      "reasoning.encrypted_content"
    ],
    "input": [
      {
        "content": [
          {
            "text": "Search for garden",
            "type": "input_text"
          }
        ],
        "role": "user",
        "type": "message"
      }
    ],
    "instructions": "You are ChatGPT, a helpful AI assistant.\n\nYou are Vizier, a steward.\n\n# CORE\nBe brief.",
    "model": "gpt-5.4",
    "store": false,
    "stream": true,
    "tools": [
      {
        "description": "Search your memory for passages.",
        "name": "memory_search",
        "parameters": {
          "additionalProperties": false,
          "properties": {
            "limit": {
              "description": "At most this many",
              "type": [
                "integer",
                "null"
              ]
            },
            "query": {
              "description": "What to look for",
              "type": "string"
            }
          },
          "required": [
            "limit",
            "query"
          ],
          "type": "object"
        },
        "strict": true,
        "type": "function"
      },
      {
        "description": "Run a Python script in the sandbox.",
        "name": "execute_python",
        "parameters": {
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string"
            },
            "intent": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "intent"
          ],
          "type": "object"
        },
        "strict": true,
        "type": "function"
      }
    ]
  },
  "path": "/responses"
}
